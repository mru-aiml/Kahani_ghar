# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:3100
MONGODB_URI=
# Used only until real login/JWT authentication is added.
DEMO_USER_ID=local-family
# Leave true for local demo data. Set false when Google authentication is enabled.
ALLOW_DEMO_AUTH=true

# Supabase Auth validates Google-issued user sessions for this API.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Gnani Prisma / Timbre
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_STT_MODEL=prisma-v2.5
GNANI_TTS_MODEL=timbre-v2.5

# Groq generates story structure and branches. This is separate from GNANI_API_KEY.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
