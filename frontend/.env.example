# ============================================================
# KahaniGhar environment variables
# Copy to .env.local and fill in real values. Never commit .env*.
# ============================================================

# --- Gnani Speech APIs (SERVER-ONLY) ---
# Generate at https://app.gnani.ai/voice  (5,000 credits on the challenge account)
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
# Model names are config-driven. Challenge requires naming Prisma v2.5 / Timbre v2.5.
GNANI_STT_MODEL=prisma-v2.5
GNANI_TTS_MODEL=timbre-v2.5
GNANI_VC_MODEL=vachana-vc-v1
# Default language for STT when the UI does not specify one
GNANI_STT_LANGUAGE=hi-IN

# --- Story LLM (Gnani Evon, served via an OpenAI-compatible endpoint) ---
# Evon access is currently pending; leave blank to run in mock mode.
# When available, set LLM_URL to the endpoint, LLM_KEY if required, LLM_MODEL to the model id.
LLM_URL=
LLM_KEY=
LLM_MODEL=gnani-evon-v3.3

# --- LAN development (optional) ---
# Comma-separated list of extra dev origins allowed by Next.js (e.g. 192.168.1.5).
NEXT_ALLOWED_DEV_ORIGINS=

# --- Supabase ---
# URL and anon key may be public (RLS protects data); service role is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3100
# Per-IP rate limit for routes that call Gnani (credits are limited).
RATE_LIMIT_PER_IP_PER_MIN=10

# --- Standalone Express + MongoDB backend ---
# Set this to use backend/ instead of the old Next.js route handlers.
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SERVICE_MODE=api

# Google login is provided by Supabase Auth. Enable Google in its dashboard and
# add http://localhost:3100/auth/callback to the project's Redirect URLs.
